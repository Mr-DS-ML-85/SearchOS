APP_DEBUG=false
LOG_LEVEL=INFO
APP_NAME=searchos
APP_VERSION=1.0.0

# --- Gateway ---
# JSON list, comma list, or *. `*` also disables credentialed CORS automatically.
CORS_ORIGINS=

# --- Postgres (pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=searchos
POSTGRES_PASSWORD=searchos
POSTGRES_DB=searchos
DATABASE_URL=postgresql+asyncpg://searchos:searchos@postgres:5432/searchos

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_RATELIMIT_DB=2

# --- SPA / heavy-JS rendering (headless browser renderer service) ---
RENDERER_URL=http://renderer:8010
RENDER_TIMEOUT_SECONDS=35
RENDER_MAX_BYTES=10485760

# --- Live web fallback (optional SearXNG instance) ---
# Start with: docker compose --profile web up -d searxng
# Results are saved into the local index so future term queries hit them.
SEARXNG_URL=http://searxng:8080

# Web fallback chain. SearXNG is primary; these are tried in order when it
# fails, and the first one that answers wins.
#
# Tavily works with NO account via keyless access (X-Tavily-Access-Mode), so
# it is the only credential-free tier. Set TAVILY_API_KEY to use your quota
# instead; a key takes precedence over keyless.
TAVILY_API_KEY=
TAVILY_KEYLESS=true

# Exa's REST API returns 402 (x402 payment required) without a key. Its free
# tier is the hosted MCP server, not this endpoint.
EXA_API_KEY=

# s.jina.ai returns 401 without a key. A free key includes 10M tokens.
JINA_API_KEY=

# After every tier fails, stop attempting live providers for this long and
# serve the degraded local result instead.
SEARCH_CASCADE_COOLDOWN_SECONDS=30
SEARXNG_TIMEOUT_SECONDS=12
# SearXNG is only skipped when local strict matches >= this many AND fresh.
# Low local coverage (fewer than this) always reaches out to live web.
SEARXNG_LOCAL_MIN_HITS=3
# Local results within this age (seconds) are considered fresh enough to skip web.
SEARXNG_LOCAL_TTL_SECONDS=3600

# --- Local index (own search engine: FTS + vector) ---
LOCAL_INDEX_ENABLED=true
LOCAL_INDEX_FTS_WEIGHT=0.6
LOCAL_INDEX_VECTOR_WEIGHT=0.4

# --- Embeddings (local, no external API) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Informational only. The vector column width is fixed at 384 by migration 0001;
# changing this value does not resize the column.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# --- Retrieval ---
RRF_K=60
RERANK_ENABLED=true

# ColBERT late-interaction reranking. Costs ~128KB per chunk in token vectors
# and must be indexed before it has anything to score, so it is off by default.
# COLBERT_ENABLED=true
# COLBERT_MODEL=colbert-ir/colbertv2.0
# COLBERT_TOP_N=50
RERANK_TOP_K=20

# --- Caching ---
SEARCH_CACHE_TTL_SECONDS=300
EXTRACT_CACHE_TTL_SECONDS=3600

# --- Extraction / Fetch ---
EXTRACT_MAX_BYTES=5242880
EXTRACT_TIMEOUT_SECONDS=20
EXTRACT_USER_AGENT=SearchOSBot/1.0 (+https://searchos.local/bot)
FETCH_RESPECT_ROBOTS=true

# --- Auth / rate limiting ---
AUTH_ENABLED=true
# REQUIRED when AUTH_ENABLED=true (>=16 chars, must not start with "change-me").
# Generate: python3 -c "import secrets; print('sk_' + secrets.token_urlsafe(32))"
BOOTSTRAP_ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600
RATE_LIMIT_PER_DAY=5000

# --- Workers ---
WORKER_INGEST_POLL_INTERVAL_SECONDS=2
WORKER_SNIPPET_BATCH=10
WORKER_SNIPPET_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=3

# --- Continuous crawler (link following + re-crawl of stale index) ---
CRAWLER_FOLLOW_LINKS=true
CRAWLER_MAX_DEPTH=2
CRAWLER_BATCH_SIZE=25
CRAWLER_FOLLOW_DOMAINS=same
CRAWLER_CONTINUOUS_ENABLED=true
CRAWLER_CONTINUOUS_INTERVAL_SECONDS=3600
CRAWLER_RECRAWL_AFTER_SECONDS=604800
CRAWLER_RECRAWL_BATCH=100

# --- Observability ---
PROMETHEUS_ENABLED=true

# ---- Security / egress -------------------------------------------------
# Refuse fetches to non-public destinations (SSRF guard). Applies to
# /v1/extract, the crawler and the renderer.
FETCH_BLOCK_PRIVATE_NETWORKS=true
# Comma list of hosts permitted to resolve to private addresses (e.g. the
# renderer service, or a local dev origin).
FETCH_ALLOW_PRIVATE_NETWORKS=
FETCH_MAX_REDIRECTS=5
ROBOTS_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=262144

# ---- Ops endpoints ------------------------------------------------------
# When true, /stats and /metrics require an API key (they run COUNT(*) and
# expose internals). Leave false only if the gateway port is not reachable
# from untrusted networks.
RATE_LIMIT_HEALTH_ENDPOINTS=true

# ---- Rate limiting ------------------------------------------------------
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10

# ---- Shared secrets -----------------------------------------------------
# Must match RENDERER_TOKEN in the renderer service.
RENDERER_TOKEN=

# ---- Prometheus multi-process -------------------------------------------
# Read directly from the OS environment by app/metrics.py:render_metrics. Set
# to a writable dir shared by all uvicorn workers so /metrics aggregates across
# processes instead of reporting only whichever worker served the scrape.
# (docker compose already sets it.)
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# ---- Worker -------------------------------------------------------------
WORKER_METRICS_PORT=9101
# The gateway owns migrations; leave false so only one process runs them.
WORKER_RUN_MIGRATIONS=false
WORKER_RETRY_BASE_SECONDS=30
# Backoff gate and chunking.
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ---- Crawler ------------------------------------------------------------
CRAWLER_MAX_URLS_PER_SEED=5000

# ---- Search -------------------------------------------------------------
SEARCH_MAX_OFFSET=1000
SEARCH_MAX_CANDIDATES=100
VECTOR_MIN_SIMILARITY=0.0

# ---- Database pool ------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

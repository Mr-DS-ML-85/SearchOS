APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
APP_NAME=searchos
APP_VERSION=1.0.0

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
CORS_ORIGINS=*

# --- Postgres (pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=searchos
POSTGRES_PASSWORD=searchos
POSTGRES_DB=searchos
DATABASE_URL=postgresql+asyncpg://searchos:searchos@postgres:5432/searchos

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_RATELIMIT_DB=2

# --- SPA / heavy-JS rendering (headless browser renderer service) ---
RENDERER_URL=http://renderer:8010
RENDER_TIMEOUT_SECONDS=35
RENDER_MAX_BYTES=10485760

# --- Live web fallback (optional SearXNG instance) ---
# Start with: docker compose --profile web up -d searxng
# Results are saved into the local index so future term queries hit them.
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT_SECONDS=12
# SearXNG is only skipped when local strict matches >= this many AND fresh.
# Low local coverage (fewer than this) always reaches out to live web.
SEARXNG_LOCAL_MIN_HITS=3
# Local results within this age (seconds) are considered fresh enough to skip web.
SEARXNG_LOCAL_TTL_SECONDS=3600

# --- Local index (own search engine: FTS + vector) ---
LOCAL_INDEX_ENABLED=true
LOCAL_INDEX_FTS_WEIGHT=0.6
LOCAL_INDEX_VECTOR_WEIGHT=0.4
LOCAL_INDEX_K=25

# --- Embeddings (local, no external API) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# --- Retrieval ---
FUSION_MODE=rrf
RRF_K=60
RERANK_ENABLED=true
RERANK_TOP_K=20
DEFAULT_NUM_RESULTS=10
MAX_NUM_RESULTS=50

# --- Caching ---
SEARCH_CACHE_TTL_SECONDS=300
EXTRACT_CACHE_TTL_SECONDS=3600
CACHE_HIT_LIMIT=100000

# --- Extraction / Fetch ---
EXTRACT_MAX_BYTES=5242880
EXTRACT_TIMEOUT_SECONDS=20
EXTRACT_USER_AGENT=SearchOSBot/1.0 (+https://searchos.local/bot)
FETCH_RESPECT_ROBOTS=true

# --- Auth / rate limiting ---
AUTH_ENABLED=true
BOOTSTRAP_ADMIN_API_KEY=change-me-to-a-long-random-secret
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600
RATE_LIMIT_PER_DAY=5000
RATE_LIMIT_BURST=10

# --- Workers ---
WORKER_INGEST_BATCH=5
WORKER_INGEST_POLL_INTERVAL_SECONDS=2
WORKER_SNIPPET_BATCH=10
WORKER_SNIPPET_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=3

# --- Continuous crawler (link following + re-crawl of stale index) ---
CRAWLER_FOLLOW_LINKS=true
CRAWLER_MAX_DEPTH=2
CRAWLER_BATCH_SIZE=25
CRAWLER_FOLLOW_DOMAINS=same
CRAWLER_CONTINUOUS_ENABLED=true
CRAWLER_CONTINUOUS_INTERVAL_SECONDS=3600
CRAWLER_RECRAWL_AFTER_SECONDS=604800
CRAWLER_RECRAWL_BATCH=100

# --- Observability ---
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
